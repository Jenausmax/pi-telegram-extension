# Конфигурация pi Telegram bridge bot.
# Скопировать в .env на сервере, заполнить значения, выставить права 0600.
# Файл .env содержит секреты и НЕ коммитится в git.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Telegram user ID, которым разрешено управлять агентом (узнать у @userinfobot).
# Можно перечислить несколько через запятую: 11111111,22222222
ALLOWED_USER_ID=PASTE_YOUR_TELEGRAM_USER_ID_HERE

# API-ключ z.ai Coding Plan (нужен запускаемому агенту pi).
ZAI_CODING_API_KEY=PASTE_YOUR_ZAI_KEY_HERE

# Провайдер и модель по умолчанию (определены в ~/.pi/agent/models.json)
PI_PROVIDER=zai-coding
PI_MODEL=glm-5.1
PI_MODELS=glm-5.1,glm-5-turbo,glm-4.7,glm-4.5-air

# Бинарник pi (стабильный путь через symlink current)
PI_BIN=/home/max/.local/share/pi-node/current/bin/pi

# Рабочая директория агента и хранилище сессий/состояния
PI_WORKDIR=/home/max/pi-telegram-bot/workspace
PI_SESSION_DIR=/home/max/pi-telegram-bot/sessions
PI_EXPORT_DIR=/home/max/pi-telegram-bot/exports
PI_STATE_FILE=/home/max/pi-telegram-bot/state.json
